# ── Environment variable reference ──────────────────────────────────────────
# Copy the relevant block into the correct env file:
#   Local dev  →  .env.local        (gitignored, used by `npx expo start`)
#   Production →  .env.production   (gitignored, used by EAS Build)
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to client-side code.
# All other variables (e.g. SENTRY_AUTH_TOKEN) are build-time only.

# ── Local dev (.env.local) ───────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Production (.env.production) ────────────────────────────────────────────
# EXPO_PUBLIC_API_URL=https://api.your-aws-domain.com/api
# EXPO_PUBLIC_SENTRY_DSN=get-from-sentry-dashboard
# SENTRY_AUTH_TOKEN=get-from-sentry-auth-tokens
