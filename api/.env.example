# ── Environment variable reference ──────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# .env is gitignored — never commit real secrets.
#
# In production (AWS), set these as environment variables directly on the
# hosting service (Elastic Beanstalk env properties, ECS task definition,
# EC2 user data, etc.) — do not deploy a .env file to production.

# ── Django ───────────────────────────────────────────────────────────────────

# Generate a strong key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-dev-secret-key-here

# CRITICAL: must be False in production
DEBUG=True

# Dev: localhost only
# Production: your AWS domain / ELB hostname, e.g. api.your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Dev: local Postgres
# Production: AWS RDS endpoint, e.g. postgresql://user:pass@your-rds.amazonaws.com:5432/hivemind
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/hivemind

# ── AWS S3 (leave blank for local dev — file uploads disabled) ───────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1

# ── Sentry (leave blank for local dev — error reporting disabled) ────────────
SENTRY_DSN=
